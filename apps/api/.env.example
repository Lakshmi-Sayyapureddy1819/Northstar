# NorthStar API — environment configuration (ADR 0003: config from env only).
# Copy to `.env` for local development. All keys are prefixed NORTHSTAR_.

NORTHSTAR_APP_NAME="NorthStar API"
NORTHSTAR_ENVIRONMENT=local
NORTHSTAR_DEBUG=false

# Infrastructure (provided by infra/compose in Milestone 4).
NORTHSTAR_DATABASE_URL=postgresql://northstar:northstar@localhost:5432/northstar
NORTHSTAR_REDIS_URL=redis://localhost:6379/0
