# NorthStar web — local environment variables.
# Next.js requires the NEXT_PUBLIC_ prefix for anything shipped to the browser
# bundle (a platform convention, distinct from the backend's NORTHSTAR_ prefix —
# see docs/features/phase1/slice-3-map-experience.md, "Risks", for why that's
# not an ADR 0003 violation).

# Public Mapbox access token (scoped/restrictable in the Mapbox dashboard).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Backend API base URL. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
